+/*
+ * Source mode changes are normally reported by the HDMI-RX interrupt, which
+ * never arrives with upstream TF-A, so the driver kept a stale format (e.g.
+ * 1024x768 while the source sent 4K60) and capture stalled. Compare the
+ * detected timing with the active one once a second and run the normal
+ * signal-change handling when they differ twice in a row.
+ */
+static void hdmirx_poll_signal_change(struct rk_hdmirx_dev *hdmirx_dev)
+{
+	static int mismatch;
+	struct v4l2_dv_timings t = {};
+	struct v4l2_bt_timings *cur = &hdmirx_dev->timings.bt;
+	bool changed;
+
+	if (!mutex_trylock(&hdmirx_dev->work_lock))
+		return;
+	if (!hdmirx_dev->get_timing || port_no_link(hdmirx_dev) ||
+	    signal_not_lock(hdmirx_dev) ||
+	    hdmirx_get_detected_timings(hdmirx_dev, &t, false)) {
+		mismatch = 0;
+		mutex_unlock(&hdmirx_dev->work_lock);
+		return;
+	}
+	changed = t.bt.width != cur->width || t.bt.height != cur->height ||
+		  t.bt.interlaced != cur->interlaced ||
+		  abs((s64)t.bt.pixelclock - (s64)cur->pixelclock) > (s64)cur->pixelclock / 100;
+	mismatch = changed ? mismatch + 1 : 0;
+	mutex_unlock(&hdmirx_dev->work_lock);
+
+	if (mismatch >= 2) {
+		mismatch = 0;
+		dev_info(hdmirx_dev->dev, "poll: source timing %ux%u@%llu differs from %ux%u@%llu, re-detecting\n",
+			 t.bt.width, t.bt.height, t.bt.pixelclock,
+			 cur->width, cur->height, cur->pixelclock);
+		process_signal_change(hdmirx_dev);
+	}
+}
